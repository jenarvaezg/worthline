WORTHLINE_DATA_DIR=.local/worthline

# Optional: a FREE CoinGecko "demo" API key (https://www.coingecko.com/en/api/pricing).
# Sent as the `x-cg-demo-api-key` header on every CoinGecko call, lifting the rate
# limit from the public tier (~5-15 req/min) to ~30 req/min. Without it, a Binance
# sync's live-price burst starves the history-range calls that follow (they 429),
# silently zeroing the reconstructed monthly history. Leave blank to use the public
# unauthenticated tier.
WORTHLINE_COINGECKO_API_KEY=

# Optional: Google OAuth credentials for Auth.js v5 sign-in. When all three are
# set, the app enters hosted mode: signed-out requests to real pages redirect to
# /login and signed-in users get their own provisioned workspace.
# Leave them blank to keep the local no-auth single-user mode.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Hosted multi-tenant control plane (ADR 0030). Required when AUTH_GOOGLE_ID is
# set; ignored in local no-auth mode.
#
# - WORTHLINE_CONTROL_PLANE_DB_URL: the single libSQL database mapping users →
#   workspaces → grants.
# - WORTHLINE_DB_AUTH_TOKEN: Turso token used to open the CONTROL PLANE (and as
#   a temporary fallback for pre-#1185 workspace rows that have not been
#   backfilled yet). New workspaces open with a per-database JWT stored on the
#   control-plane `workspaces` row; after backfill + group-token rotation this
#   env var is no longer a data-plane master key.
# - TURSO_API_TOKEN / TURSO_ORG / TURSO_GROUP: Turso Platform API credentials used
#   to provision a fresh per-user workspace database (and mint its scoped token)
#   on first login.
WORTHLINE_CONTROL_PLANE_DB_URL=
WORTHLINE_DB_AUTH_TOKEN=
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_GROUP=

# Daily provisioning cap (#1175, ADR 0110): how many NEW workspaces one UTC day
# may create. Existing users always sign in, whatever this says. 0 closes
# registration. Unset or blank: no cap locally, in e2e and self-hosted — but in a
# Vercel PRODUCTION deploy (VERCEL_ENV=production) it CLOSES new sign-ups, like a
# value that is not a non-negative integer does anywhere. Set it explicitly in
# production. Every refused sign-up gets «hoy estamos llenos, vuelve mañana» and
# raises a maintainer alert in /admin/alertas naming the cause. The figure itself
# is an operational decision kept out of git.
WORTHLINE_DAILY_PROVISIONING_CAP=

# Error monitoring with Sentry (#1175, ADR 0110), server-side only. Without a DSN
# the SDK is never initialized. Errors only: no tracing, replay, sessions, logs or
# analytics, and every event is reduced to error type + code location + route
# pattern before it leaves — never the error's text
# (apps/web/app/error-monitoring.ts). SENTRY_TRACES_SAMPLE_RATE and
# SENTRY_SPOTLIGHT are ignored on purpose; SENTRY_ENVIRONMENT / SENTRY_RELEASE are
# optional labels.
SENTRY_DSN=

# Optional: open a single fixed remote libSQL workspace directly (local-against-
# remote dev, single-tenant). Ignored when the control plane above is configured.
WORTHLINE_DB_URL=

# Correo (#1174, PRD #1171) vía Resend. Opcional: sin RESEND_API_KEY nada se
# rompe — el feedback de «Enviar feedback» se guarda igual en /admin/alertas y el
# correo se omite con un log.
# - WORTHLINE_ADMIN_EMAIL: el mantenedor (el mismo que abre /admin). Es quien
#   recibe el correo de cada feedback; sin él, el correo se omite.
# - WORTHLINE_EMAIL_FROM: remitente `Nombre <direccion>` en un dominio verificado
#   en Resend. Vacío = `onboarding@resend.dev`, el remitente de pruebas de Resend,
#   que SOLO entrega a la dirección dueña de la cuenta de Resend: vale para avisar
#   al mantenedor, no para escribir a usuarios (#1173).
WORTHLINE_ADMIN_EMAIL=
RESEND_API_KEY=
WORTHLINE_EMAIL_FROM=

# Asistente financiero (#627/#704, ADR 0061). Cada entrada solo se activa con
# su credencial directa. El orden solo puede reordenar la allowlist validada.
GOOGLE_GENERATIVE_AI_API_KEY=
# Extractor visual dedicado (#990). El modelo no forma parte del pool de chat.
WORTHLINE_EXTRACTOR_MODEL=gemini-3.1-flash-lite
CEREBRAS_API_KEY=
WORTHLINE_CHAT_PROVIDER_ORDER=google,cerebras
# Scope estable para cooldowns. Es obligatorio con control plane fuera de Vercel;
# Vercel usa VERCEL_URL (o VERCEL_ENV) por defecto.
WORTHLINE_CHAT_DEPLOYMENT_KEY=

# Billing → entitlements (PRD #1160, contrato #1135). Sin proveedor configurado
# no hay billing: la ruta de webhook responde 503 y /premium lo dice honestamente.
# Selecciona el adapter: `fake` (pruebas/e2e, S5) o `paddle` (MoR real, S6).
WORTHLINE_BILLING_PROVIDER=
#
# Adapter de pruebas (`fake`): firma HMAC del webhook + checkout/portal simulados.
WORTHLINE_BILLING_FAKE_SECRET=
WORTHLINE_BILLING_FAKE_CHECKOUT_URL=
WORTHLINE_BILLING_FAKE_PORTAL_URL=
#
# Adapter real de Paddle (`paddle`, #1166). API key y secreto del destino de
# notificaciones son OBLIGATORIOS (sin ambos el adapter no se registra). El
# secreto NO es la API key: es el de ESE destino de notificaciones concreto.
WORTHLINE_PADDLE_API_KEY=
WORTHLINE_PADDLE_WEBHOOK_SECRET=
# `sandbox` (por defecto) o `production`.
WORTHLINE_PADDLE_ENV=sandbox
# Client-side token de Paddle (#1221) — Paddle → Developer tools →
# Authentication → Client-side tokens. Lo usa Paddle.js en /premium/pagar, la
# página que es el default payment link de la cuenta. Es público por diseño (va
# al bundle del navegador); el que cobra es la API key de arriba.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# `sandbox` (por defecto) o `production` — el entorno que Paddle.js inicializa.
# Se declara aparte de WORTHLINE_PADDLE_ENV porque el cliente no ve las env
# vars del servidor.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Price id por carril (#1126). Un tier sin price id NO se ofrece en el checkout:
# así se despublica el lifetime al agotarse el cupo sin tocar código.
WORTHLINE_PADDLE_PRICE_MONTHLY=
WORTHLINE_PADDLE_PRICE_ANNUAL=
WORTHLINE_PADDLE_PRICE_LIFETIME=
